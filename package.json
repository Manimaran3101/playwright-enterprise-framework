{
  "name": "playwright-enterprise-framework",
  "version": "0.1.0",
  "private": true,
  "description": "UI and API tests with Playwright and TypeScript for the Practice Software Testing (Toolshop) demo app.",
  "author": "Manimaran Murugan",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:e2e": "playwright test --project=chromium --grep @e2e",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:visual": "playwright test --project=chromium --grep @visual",
    "test:visual:update": "playwright test --project=chromium --grep @visual --update-snapshots",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "demo:record": "playwright test --config=playwright.demo.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "gifenc": "^1.0.3",
    "husky": "^9.1.7",
    "jpeg-js": "^0.4.4",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "zod": "^4.6.7"
  }
}
